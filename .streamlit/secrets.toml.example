# Copy this file to .streamlit/secrets.toml and fill in your own values.
# .streamlit/secrets.toml is gitignored -- the service-account key and the
# admin password must never be committed. For a local run you can use the
# matching environment variables (FCM_API_KEY, ...) instead; see
# fcm_client.py's module docstring for the full list.

[fcm]
# Project settings -> General -> Your apps -> Web app -> SDK setup and
# configuration -> Config. These values are public by design (they ship
# to every browser), but keeping them in secrets lets one checkout point
# at a different Firebase project without a code change.
api_key = "AIzaSy..."
auth_domain = "your-project.firebaseapp.com"
project_id = "your-project"
messaging_sender_id = "123456789012"
app_id = "1:123456789012:web:abc123def456"

# Cloud Messaging -> Web Push certificates -> Key pair. Also public; it is
# passed to the browser to create the push subscription.
vapid_key = "BEl6..."

# Project settings -> Service accounts -> Generate new private key.
# Paste the ENTIRE downloaded JSON file as one TOML literal string. This
# one is a real secret: it can send notifications to your project.
service_account_json = '''{
  "type": "service_account",
  "project_id": "your-project",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com"
}'''

[ads_admin]
# Staff sign-in for /Ads_Admin uses Firebase Authentication
# (email/password), not a shared password. Enable Email/Password under
# Authentication -> Sign-in method, add each staff member under
# Authentication -> Users, then list their addresses here. Only these
# addresses -- with a verified email -- can open the dashboard.
emails = ["staff@example.com"]
